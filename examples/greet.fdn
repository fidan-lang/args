use "../src/init.fdn" as args
use std.env

var spec = {
    "name": {"kind": "value", "short": "n", "default": "Dal"},
    "verbose": {"kind": "flag", "short": "v"},
}
var parsed = args.parse(env.args(), spec)

if parsed["error"] != "" {
    eprint(parsed["error"])
} else {
    if parsed["values"]["help"] {
        print(args.help("greet", "0.1.0", "Greet a person", spec))
    } else {
        if parsed["values"]["version"] {
            print("0.1.0")
        } else {
            print("Hello, " + parsed["values"]["name"] + "!")
        }
    }
}
